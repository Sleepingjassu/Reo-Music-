<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="2dp"/>
            <solid android:color="@color/surface_3"/>
            <size android:height="3dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp"/>
                <solid android:color="@color/accent"/>
                <size android:height="3dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
