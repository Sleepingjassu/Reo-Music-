<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="always"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:id="@+id/now_playing_drag_area"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <View
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_drag_handle" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="NOW PLAYING"
                android:textColor="@color/text_faint"
                android:textSize="10sp"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/now_playing_collapse"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_chevron_down"
                android:padding="8dp"
                android:contentDescription="Collapse" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="REO"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <ImageButton
                android:id="@+id/np_sleep_timer_btn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_moon"
                android:tint="@color/text_muted"
                android:padding="9dp"
                android:contentDescription="Sleep timer" />
            <ImageButton
                android:id="@+id/np_equalizer_btn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_equalizer"
                android:tint="@color/text_muted"
                android:padding="9dp"
                android:contentDescription="Equalizer" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/np_art_gesture_area"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:id="@+id/np_album_art_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="22dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/surface_2"
                android:layout_gravity="center">
                <ImageView
                    android:id="@+id/np_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_album_art_placeholder"
                    android:contentDescription="Album art" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/np_track_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nothing playing"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end" />
                <TextView
                    android:id="@+id/np_track_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Search for a song to begin"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/np_heart_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_heart_outline"
                android:tint="@color/text_primary"
                android:padding="12dp"
                android:contentDescription="Like" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/np_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:progressDrawable="@drawable/seekbar_progress_track"
            android:thumb="@drawable/thumb_seek"
            android:splitTrack="false"
            android:max="1000"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/np_time_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/np_time_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/np_shuffle_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Shuffle" />
            <ImageButton
                android:id="@+id/np_btn_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_prev"
                android:padding="15dp"
                android:contentDescription="Previous" />
            <ImageButton
                android:id="@+id/np_btn_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/ripple_circle_accent"
                android:src="@drawable/ic_play"
                android:tint="@color/bg_black"
                android:padding="21dp"
                android:contentDescription="Play" />
            <ImageButton
                android:id="@+id/np_btn_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_next"
                android:padding="15dp"
                android:contentDescription="Next" />
            <ImageButton
                android:id="@+id/np_download_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_download"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Download" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/np_queue_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_queue"
                android:tint="@color/text_primary"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:text="Up next"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/np_queue_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/np_queue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:text="Your queue is ready. Keep listening to build it up."
            android:textColor="@color/text_faint"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/np_lyrics_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_lyrics"
                android:tint="@color/text_muted"
                android:padding="12dp"
                android:contentDescription="Lyrics" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:text="Lyrics, downloads and audio controls"
                android:textColor="@color/text_faint"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
