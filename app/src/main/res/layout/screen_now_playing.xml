<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:clipToPadding="false"
    android:overScrollMode="always"
    android:scrollbars="none"
    android:scrollbarSize="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="28dp">

        <!-- Drag handle / collapse -->
        <LinearLayout
            android:id="@+id/now_playing_drag_area"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_drag_handle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="NOW PLAYING"
                android:textColor="@color/text_faint"
                android:textSize="10sp"
                android:letterSpacing="0.24"
                android:gravity="center" />

        </LinearLayout>

        <!-- Top action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/now_playing_collapse"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_chevron_down"
                android:padding="7dp"
                android:contentDescription="Collapse" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/np_sleep_timer_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_moon"
                android:tint="@color/text_muted"
                android:padding="8dp"
                android:contentDescription="Sleep timer" />

            <ImageButton
                android:id="@+id/np_equalizer_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_equalizer"
                android:tint="@color/text_muted"
                android:padding="8dp"
                android:contentDescription="Equalizer" />

            <ImageButton
                android:id="@+id/np_lyrics_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_lyrics"
                android:tint="@color/text_muted"
                android:padding="8dp"
                android:contentDescription="Lyrics" />

            <ImageButton
                android:id="@+id/np_heart_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_heart_outline"
                android:tint="@color/text_muted"
                android:padding="8dp"
                android:contentDescription="Like" />

        </LinearLayout>

        <!-- Album art -->
        <FrameLayout
            android:id="@+id/np_art_gesture_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:id="@+id/np_album_art_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="28dp"
                app:cardElevation="18dp"
                app:cardBackgroundColor="@color/surface_2"
                app:contentPadding="0dp">

                <ImageView
                    android:id="@+id/np_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_album_art_placeholder"
                    android:contentDescription="Album art" />

            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <com.reomusic.VisualizerBarView
            android:id="@+id/np_visualizer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp" />

        <!-- Title / artist -->
        <TextView
            android:id="@+id/np_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nothing playing"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/np_track_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Search for a song to begin"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Progress -->
        <SeekBar
            android:id="@+id/np_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="20dp"
            android:progressDrawable="@drawable/seekbar_progress_track"
            android:thumb="@drawable/thumb_seek"
            android:splitTrack="false"
            android:max="1000"
            android:progress="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/np_time_elapsed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/np_time_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="@color/text_faint"
                android:textSize="11sp"
                android:gravity="end" />

        </LinearLayout>

        <!-- Transport controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/np_shuffle_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/text_muted"
                android:padding="10dp"
                android:contentDescription="Smart shuffle" />

            <ImageButton
                android:id="@+id/np_btn_prev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_prev"
                android:padding="14dp"
                android:contentDescription="Previous" />

            <ImageButton
                android:id="@+id/np_btn_play_pause"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/ripple_circle_accent"
                android:src="@drawable/ic_play"
                android:tint="@color/bg_black"
                android:padding="19dp"
                android:contentDescription="Play" />

            <ImageButton
                android:id="@+id/np_btn_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_next"
                android:padding="14dp"
                android:contentDescription="Next" />

            <ImageButton
                android:id="@+id/np_download_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/ripple_circle_ghost"
                android:src="@drawable/ic_download"
                android:tint="@color/text_muted"
                android:padding="10dp"
                android:contentDescription="Download" />

        </LinearLayout>

        <!-- Algorithmic up-next queue preview -->
        <LinearLayout
            android:id="@+id/np_queue_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_circle_ghost"
            android:padding="4dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_queue"
                android:tint="@color/text_faint"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="UP NEXT"
                android:textColor="@color/text_faint"
                android:textSize="11sp"
                android:letterSpacing="0.16" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See queue"
                android:textColor="@color/accent"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/np_queue_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/np_queue_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Building your queue..."
            android:textColor="@color/text_faint"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
