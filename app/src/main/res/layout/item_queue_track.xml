<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_rounded_pressed"
    android:padding="8dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/queue_item_art"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_thumb_small"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/queue_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/queue_item_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/queue_item_heart"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/ripple_circle_ghost"
        android:src="@drawable/ic_heart_outline"
        android:tint="@color/text_muted"
        android:padding="6dp"
        android:visibility="gone"
        android:contentDescription="Like" />

    <ImageButton
        android:id="@+id/queue_item_up"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/ripple_circle_ghost"
        android:src="@drawable/ic_arrow_up"
        android:tint="@color/text_muted"
        android:padding="6dp"
        android:contentDescription="Move up" />

    <ImageButton
        android:id="@+id/queue_item_down"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/ripple_circle_ghost"
        android:src="@drawable/ic_arrow_down"
        android:tint="@color/text_muted"
        android:padding="6dp"
        android:contentDescription="Move down" />

    <ImageButton
        android:id="@+id/queue_item_remove"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/ripple_circle_ghost"
        android:src="@drawable/ic_close"
        android:tint="@color/text_muted"
        android:padding="6dp"
        android:contentDescription="Remove" />

</LinearLayout>
