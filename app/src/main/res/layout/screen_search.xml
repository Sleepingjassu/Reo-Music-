<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_black"
    android:paddingTop="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:fontFamily="sans-serif-medium" />
        <ImageButton
            android:id="@+id/search_clear_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/ripple_circle_ghost"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted"
            android:padding="10dp"
            android:visibility="gone"
            android:contentDescription="Clear search" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_field"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_primary"
            android:contentDescription="Search" />
        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Songs, artists, albums, playlists"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />
        <ImageButton
            android:id="@+id/search_voice_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/ripple_circle_ghost"
            android:src="@drawable/ic_mic"
            android:tint="@color/text_muted"
            android:padding="11dp"
            android:contentDescription="Voice search" />
        <ImageButton
            android:id="@+id/search_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/ripple_circle_accent"
            android:src="@drawable/ic_search"
            android:tint="@color/bg_black"
            android:padding="11dp"
            android:contentDescription="Search" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/search_filter_all" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="All" android:textColor="@color/text_primary" android:textSize="12sp" android:background="@drawable/bg_chip_selected" />
            <TextView android:id="@+id/search_filter_songs" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="Songs" android:textColor="@color/text_primary" android:textSize="12sp" android:background="@drawable/bg_chip" />
            <TextView android:id="@+id/search_filter_artists" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="Artists" android:textColor="@color/text_primary" android:textSize="12sp" android:background="@drawable/bg_chip" />
            <TextView android:id="@+id/search_filter_albums" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="Albums" android:textColor="@color/text_primary" android:textSize="12sp" android:background="@drawable/bg_chip" />
            <TextView android:id="@+id/search_filter_playlists" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:gravity="center" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="Playlists" android:textColor="@color/text_primary" android:textSize="12sp" android:background="@drawable/bg_chip" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/search_recent_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent searches" android:textColor="@color/text_primary" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/search_clear_history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" android:textColor="@color/accent" android:textSize="12sp" android:clickable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/search_recent_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </ScrollView>
</LinearLayout>
